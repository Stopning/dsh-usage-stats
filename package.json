{
  "name": "dsh-usage-stats",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Token usage, cost, budget and host CPU statistics for DSH sessions.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "usage",
    "cost",
    "budget",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stopning/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/Stopning/dsh-usage-stats#readme"
}
